window.page4_callback(["<div class=\"newpage\" id=\"page4\" style=\"width: 902px; height:677px\">\n<div class=text_layer style=\"z-index:2\"><div class=ie_fix>\n&nbsp;\n<div class=\"ff1\" style=\"font-size:190px\">\n<span class=a style=\"left:155px;top:183px;word-spacing:-4px;color:#ffffff\">Sample Results</span></div>\n<div class=\"ff0\" style=\"font-size:142px\">\n<span class=a style=\"left:297px;top:2115px;color:#ffffff\">●</span></div>\n<div class=\"ff2\" style=\"font-size:136px\">\n<span class=a style=\"left:500px;top:2118px;word-spacing:3px;letter-spacing:-1px;color:#ffffff\">Ran 10,000 simulations of 2004 and 2008 presidential </span><span class=a style=\"left:500px;top:2296px;word-spacing:-4px;color:#ffffff\">elections to obtain our <span class=w8></span>forecas<span class=l6>ts</span></span></div>\n<div class=\"ff0\" style=\"font-size:142px\">\n<span class=a style=\"left:297px;top:2472px;color:#ffffff\">●</span></div>\n<div class=\"ff2\" style=\"font-size:136px\">\n<span class=a style=\"left:500px;top:2475px;word-spacing:-3px;color:#ffffff\">W<span class=l9>rote code to handle states wi<span class=w6></span>th vary<span class=w6></span>ing amounts of </span></span><span class=a style=\"left:500px;top:2653px;word-spacing:-3px;color:#ffffff\">polling data </span></div>\n<div class=\"ff0\" style=\"font-size:142px\">\n<span class=a style=\"left:297px;top:2829px;color:#ffffff\">●</span></div>\n<div class=\"ff2\" style=\"font-size:136px\">\n<span class=a style=\"left:500px;top:2832px;word-spacing:-4px;color:#ffffff\">Consider<span class=l6>ed uncer<span class=w6></span>tainty related to <span class=w6></span>state demographics </span></span><span class=a style=\"left:500px;top:3010px;word-spacing:-2px;color:#ffffff\">with the introduction of noise</span></div>\n</div>\n</div>\n<div class=image_layer style=\"z-index: 1\">\n<div class=ie_fix>\n<img class=\"absimg\" style=\"left:-1px;top:-1px;width:904px;height:678px;clip:rect(1px 903px 677px 1px)\" orig=\"http://ht