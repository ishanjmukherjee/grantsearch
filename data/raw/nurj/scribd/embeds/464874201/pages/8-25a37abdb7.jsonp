window.page8_callback(["<div class=\"newpage\" id=\"page8\" style=\"width: 902px; height:507px\">\n<div class=text_layer style=\"z-index:2\"><div class=ie_fix>\n&nbsp;\n<div class=\"ff3\" style=\"font-size:282px\">\n<span class=a style=\"left:455px;top:1074px;letter-spacing:-3px;color:#ffffff\">VOLUNTOURISM</span></div>\n<div class=\"ff3\" style=\"font-size:259px\">\n<span class=a style=\"left:2509px;top:895px;word-spacing:3px;letter-spacing:-2px;color:#ffffff\">Where you are from </span><span class=a style=\"left:2496px;top:1267px;word-spacing:-1px;color:#ffffff\">means you need my </span><span class=a style=\"left:3222px;top:1640px;color:#ffffff\">help</span></div>\n<div class=\"ff0\" style=\"font-size:71px\">\n<span class=a style=\"left:187px;top:641px;word-spacing:-2px;color:#ffffff\">“they need any help they can get”</span><span class=a style=\"left:1208px;top:1754px;color:#ffffff\">“those poor things”</span><span class=a style=\"left:1208px;top:863px;word-spacing:-1px;color:#ffffff\">“if I don’t help them, who <span class=w6></span>will?”</span><span class=a style=\"left:187px;top:1467px;word-spacing:-1px;color:#ffffff\">“they are not capable of </span><span class=a style=\"left:187px;top:1569px;word-spacing:-2px;color:#ffffff\">helping themselves”</span><span class=a style=\"left:354px;top:1925px;word-spacing:-1px;color:#ffffff\">“I know more than them”</span><span class=a style=\"left:1636px;top:2032px;color:#ffffff\">“I can do it better”</span><span class=a style=\"left:1166px;top:280px;word-spacing:-1px;color:#ffffff\">“I wouldn’t get a chance to </span><span class=a style=\"left:1166px;top:382px;word-spacing:-2px;color:#ffffff\">ever do this in <span class=w8></span>the U.S.”</span><span class=a style=\"left:455px;top:2213px;word-spacing:3px;letter-spacing:-1px;color:#ffffff\">“Any help is good help”</span><span class=a style=\"left:1420px;top:1508px;word-spacing:-1px;color:#ffffff\">“I have good intentions”</span></div>\n</div>\n</div>\n<div class=image_layer style=\"z-index: 1\">\n<div class=ie_fix>\n<img class=\"absimg\" style=\"left:-1px;top:-1px;width:904px;height:509px;clip:rect(1px 903px 508px 1px)\" orig=\"http://html.scribd.com/804z8b8ruo7xehig/images/8-25a37abdb7.jpg\"/>\n</div>\n</div>\n</div>\n\n"]);