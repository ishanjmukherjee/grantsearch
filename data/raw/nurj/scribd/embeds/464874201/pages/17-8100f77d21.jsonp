window.page17_callback(["<div class=\"newpage\" id=\"page17\" style=\"width: 902px; height:507px\">\n<div class=text_layer style=\"z-index:2\"><div class=ie_fix>\n&nbsp;\n<div class=\"ff3\" style=\"font-size:141px\">\n<span class=a style=\"left:1423px;top:245px;word-spacing:4px;letter-spacing:-2px\">PARTICIPANT BURDENS + BARRIERS</span></div>\n<div class=\"ff5\" style=\"font-size:89px\">\n<span class=a style=\"left:2272px;top:505px;word-spacing:2px\">Self-reported barriers:</span></div>\n<div class=\"ff0\" style=\"font-size:56px\">\n<span class=a style=\"left:2213px;top:685px;word-spacing:44px\">“midterms” <span class=w style=\"width:25px\"></span>“papers <span class=l style=\"margin-left:-47px\">due” <span class=w style=\"width:27px\"></span>“family </span></span><span class=a style=\"left:2213px;top:764px;word-spacing:3px\">matters” “<span class=l6>just w<span class=l6>ork” <span class=w style=\"width:32px\"></span>“didn’t <span class=l7>have <span class=l6>time to </span></span></span></span></span><span class=a style=\"left:2213px;top:842px;word-spacing:15px\">read <span class=l style=\"margin-left:-16px\">in <span class=l style=\"margin-left:-16px\">detail” <span class=w style=\"width:55px\"></span>“rough <span class=l style=\"margin-left:-19px\">week”</span></span></span></span></div>\n<div class=\"ff5\" style=\"font-size:89px\">\n<span class=a style=\"left:3612px;top:505px;word-spacing:-2px\">COVID-19 effects:</span></div>\n<div class=\"ff0\" style=\"font-size:56px\">\n<span class=a style=\"left:3596px;top:679px;word-spacing:28px\">“frustration” “strange” </span><span class=a style=\"left:3596px;top:758px;word-spacing:9px\">“difficult” “adjusting” </span><span class=a style=\"left:3596px;top:837px;word-spacing:15px\">“stuck” “stressful”</span><span class=a style=\"left:369px;top:1619px;word-spacing:-2px\">“I would not have time in my schedule to <span class=w6></span>take another class…and </span></div>\n<div class=\"ff5\" style=\"font-size:63px\">\n<span cla